{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "Minecraft Java Edition data pack version profile front matter",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "edition",
    "version",
    "release_date",
    "data_pack_format",
    "directory_schema",
    "inherits",
    "compatibility"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "edition": {
      "const": "java"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:1\\.[0-9]+(?:\\.[0-9]+)?|[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)(?:(?:-snapshot-|-pre-|-rc-)[1-9][0-9]*)?$"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "data_pack_format": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "directory_schema": {
      "enum": [
        "plural",
        "singular"
      ]
    },
    "inherits": {
      "type": [
        "string",
        "null"
      ]
    },
    "compatibility": {
      "enum": [
        "same-format",
        "breaking-format",
        "metadata-break",
        "hotfix"
      ]
    },
    "compatibility_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "origin",
          "behavior-fix",
          "schema-break",
          "experimental",
          "overlay",
          "item-components",
          "directory-rename",
          "text-entity-components",
          "strict-json",
          "small-delta",
          "world-storage"
        ]
      },
      "default": []
    },
    "channel": {
      "enum": [
        "release",
        "snapshot"
      ],
      "default": "release"
    },
    "snapshot_for": {
      "type": "string",
      "pattern": "^(?:1\\.[0-9]+(?:\\.[0-9]+)?|[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)$"
    }
  }
}
